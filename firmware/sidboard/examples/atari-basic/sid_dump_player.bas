10 REM SID DUMP PLAYER FOR THE SIDBOARD
20 REM D:SIDDUMP.BIN: FRAMES OF 25 SID REGISTERS, ONE PER VBLANK
30 REM PBI=0: FIRMWARE SID-CCTL, SID AT $D500
40 REM PBI=1: FIRMWARE SID-PBI, SID AT $D100, SELECT $D1FF
50 PBI=0
60 BASE=54528:IF PBI THEN BASE=53504
70 NREGS=25:MAXBYTES=27500
80 DIM BUF$(MAXBYTES),ML$(23)
90 FOR I=1 TO 23:READ B:ML$(I,I)=CHR$(B):NEXT I
100 ? "LOADING D:SIDDUMP.BIN..."
110 N=0:TRAP 150
120 OPEN #2,4,0,"D:SIDDUMP.BIN"
130 IF N<MAXBYTES THEN GET #2,B:N=N+1:BUF$(N,N)=CHR$(B):GOTO 130
140 GOTO 160
150 IF PEEK(195)<>136 THEN ? "ERROR ";PEEK(195):CLOSE #2:END
160 TRAP 40000:CLOSE #2
170 IF N<NREGS THEN ? "DUMP TOO SHORT":END
180 ? INT(N/NREGS);" FRAMES, ANY KEY STOPS"
190 POKE 764,255:IF PBI THEN POKE 53759,128
200 A=ADR(BUF$):M=ADR(ML$):T=PEEK(20)
210 FOR F=0 TO N-NREGS STEP NREGS
220 X=USR(M,A+F,BASE)
230 IF PEEK(20)=T THEN 230
240 T=PEEK(20)
250 IF PEEK(764)<>255 THEN F=N
260 NEXT F
270 POKE BASE+4,0:POKE BASE+11,0:POKE BASE+18,0:POKE BASE+24,0
280 IF PBI THEN POKE 53759,0
290 POKE 764,255:? "DONE":END
1000 REM USR(M,FRAME,BASE): 25 BYTES FROM FRAME TO THE SID REGISTERS
1010 REM PLA:PLA:STA $CC:PLA:STA $CB:PLA:STA $CE:PLA:STA $CD
1020 REM LDY #24:LDA ($CB),Y:STA ($CD),Y:DEY:BPL -7:RTS
1030 DATA 104,104,133,204,104,133,203,104,133,206,104,133,205
1040 DATA 160,24,177,203,145,205,136,16,249,96
